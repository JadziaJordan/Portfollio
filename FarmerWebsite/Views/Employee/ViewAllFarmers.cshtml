@model List<Prog7311_PartTwo.Models.FarmerProfileModel>

<div class="text-center mb-5">
    <h2 class="fw-bold" style="color: var(--primary-green);">All Farmer Profiles</h2>
</div>

@if (!Model.Any())
{
    <p class="text-center text-muted">No farmer profiles found.</p>
}
else
{
    <div class="row">
        @foreach (var profile in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0" style="border-left: 6px solid var(--light-green);">
                    <div class="card-header" style="background-color: var(--accent-pink); color: #333;">
                        <h5 class="mb-0">@profile.FullName</h5>
                    </div>
                    <div class="card-body" style="background-color: #fefefe;">
                        <p><strong>Email:</strong> @profile.User?.Email</p>
                        <p><strong>Location:</strong> @profile.Location</p>
                        <p><strong>Description:</strong> @profile.Description</p>
                        
                    </div>
                </div>
            </div>
        }
    </div>
}
