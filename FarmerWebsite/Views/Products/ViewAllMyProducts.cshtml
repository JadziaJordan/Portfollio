@if (Model == null || !Model.Any())
{
    <p class="text-muted text-center">No products found based on the selected filters.</p>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm" style="border: 1px solid var(--border-light);">
                    <img src="@product.ImageURL" class="card-img-top" alt="@product.ProductName" style="max-height: 200px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title" style="color: var(--primary-green); font-weight: 600;">@product.ProductName</h5>
                        <p class="card-text text-muted">@product.ProductDescription</p>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Price:</strong> R @product.ProductPrice</li>
                            <li><strong>Quantity:</strong> @product.Proudct_Qaunt</li>
                            <li><strong>Category:</strong> @product.ProductCategory</li>
                            <li><strong>Production Date:</strong> @product.Production.ToString("yyyy-MM-dd")</li>
                            <li><strong>Farmer:</strong> @product.Farmer</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
}
