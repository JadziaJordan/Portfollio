@model Prog7311_PartTwo.Models.ProductsModel

@{
    ViewData["Title"] = "Add Product";
}

<h2 class="mb-4 text-center" style="color: var(--primary-green); font-weight: bold;">Add a New Product</h2>

<form asp-action="AddProduct" asp-controller="Products" method="post" class="bg-white p-4 rounded shadow-sm" style="border: 1px solid var(--accent-pink); max-width: 600px; margin: auto;">
    <div class="form-group mb-3">
        <label asp-for="ProductName" class="form-label fw-semibold">Product Name</label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ProductPrice" class="form-label fw-semibold">Price (R)</label>
        <input asp-for="ProductPrice" class="form-control" />
        <span asp-validation-for="ProductPrice" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Proudct_Qaunt" class="form-label fw-semibold">Quantity</label>
        <input asp-for="Proudct_Qaunt" class="form-control" />
        <span asp-validation-for="Proudct_Qaunt" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ProductDescription" class="form-label fw-semibold">Description</label>
        <textarea asp-for="ProductDescription" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ProductDescription" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ImageURL" class="form-label fw-semibold">Image URL</label>
        <input asp-for="ImageURL" class="form-control" />
        <span asp-validation-for="ImageURL" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
    <label asp-for="ProductCategory" class="form-label fw-semibold">Category</label>
    @Html.DropDownListFor(model => model.ProductCategory,
        new SelectList(ViewBag.Categories as List<string>),
        "-- Select Category --",
        new { @class = "form-control" })
    <span asp-validation-for="ProductCategory" class="text-danger"></span>
</div>

    <div class="form-group mb-4">
        <label asp-for="Production" class="form-label fw-semibold">Production Date</label>
        <input asp-for="Production" class="form-control" type="date" />
        <span asp-validation-for="Production" class="text-danger"></span>
    </div>

    <div class="text-center">
        <button type="submit" class="btn" style="background-color: var(--accent-green); color: white; font-weight: 500;">Add Product</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
