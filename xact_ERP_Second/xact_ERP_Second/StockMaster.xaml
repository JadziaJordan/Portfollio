<Window x:Class="xact_ERP_Second.StockMaster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xact_ERP_Second"
        mc:Ignorable="d"
        Title="StockMaster" 
        WindowState="Maximized"
        Height="526" 
        Width="840">

    <Grid Margin="0,0,0,0">

        <!--Background-->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/SM_Background.png"
                        Stretch="UniformToFill"
                        Opacity="0.9"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!--Row 0-->
            <RowDefinition Height="89*" />
            <!--Row 1-->
            <RowDefinition Height="127*" />
            <!--Row 2-->
            <RowDefinition Height="293*" />
        </Grid.RowDefinitions>

        <!--Green Box-->
        <Grid Margin="15,10,15,0" Grid.Row="1">

            <Border
                  Background="#0B5D3B"
                  CornerRadius="9"
                  Padding="20"
                  Margin="15,10,15,0">

                <Viewbox Stretch="Uniform"
                         Margin="-16,-10,0,-10" 
                         HorizontalAlignment="Left" >

                    <Grid Width="2598" Height="250">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="411"/>
                            <ColumnDefinition Width="589"/>
                        </Grid.ColumnDefinitions>

                        <!--Column 0-->
                        <StackPanel Grid.Column="0" Margin="10,10,10,10">
                            <TextBlock Text="STOCK"
                                       Foreground="White"
                                       FontWeight="ExtraBold"
                                       FontSize="70"
                                       Margin="0,0,0,12" Width="369"
                                       HorizontalAlignment="Left" Height="82"/>

                            <TextBlock Text="Name"
                                       Foreground="White"
                                       FontSize="25"/>

                            <TextBox x:Name="StockName"
                                     Height="33"
                                     Width="325"
                                     HorizontalAlignment="Left"
                                     FontSize="24"/>

                            <TextBlock Text="Double Click an Item to Edit"
                                       Foreground="White"
                                       FontSize="25"
                                       TextAlignment="Left"
                                       Width="489"
                                       Margin="0,40,0,0"
                                       />
                        </StackPanel>

                        <!--Column 1-->
                        <StackPanel Grid.Column="1" Margin="10,10,10,10">

                            <TextBlock Text="Brand Manufacturer"
                                       Foreground="White"
                                       FontSize="25"/>

                            <TextBox x:Name="StockBrand"
                                     Height="33"
                                     Width="325"
                                     FontSize="24"
                                     HorizontalAlignment="Left"/>

                            <TextBlock Text="Category"
                                       FontSize="25"
                                       Foreground="White"
                                       HorizontalAlignment="Left"/>

                            <TextBox x:Name="StockCategory"
                                     FontSize="24"
                                     Width="325"
                                     Height="33"
                                     HorizontalAlignment="Left"/>

                            <TextBlock Text="Location"
                                       Foreground="White"
                                       FontSize="24"/>

                            <TextBox x:Name="StockLoctaion"
                                     FontSize="24"
                                     Height="33"
                                     Width="325"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!--Column 2-->
                        <StackPanel Grid.Column="2" Margin="10,10,10,10">

                            <TextBlock Text="Cost Price"
                                       Foreground="White"
                                       FontSize="25"/>

                            <!-- Cost Price with permanent R: -->
                            <TextBox x:Name="StockCost"
                                     Height="33"
                                     Width="325"
                                     FontSize="24"
                                     HorizontalAlignment="Left"
                                     Text="R:"
                                     PreviewKeyDown="Price_PreviewKeyDown"
                                     PreviewTextInput="Price_PreviewTextInput"
                                     TextChanged="Price_TextChanged"/>

                            <TextBlock Text="Selling Price"
                                       FontSize="25"
                                       Foreground="White"
                                       HorizontalAlignment="Left"/>

                            <!-- Selling Price with permanent R: -->
                            <TextBox x:Name="StockPrice"
                                     FontSize="24"
                                     Width="325"
                                     Height="33"
                                     HorizontalAlignment="Left"
                                     Text="R:"
                                     PreviewKeyDown="Price_PreviewKeyDown"
                                     PreviewTextInput="Price_PreviewTextInput"
                                     TextChanged="Price_TextChanged"/>
                        </StackPanel>

                        <!--Column 3-->
                        <StackPanel Grid.Column="3" Margin="10,10,10,10">

                            <TextBlock Text="Description"
                                       FontSize="25"
                                       Foreground="White"
                                       HorizontalAlignment="Left"/>

                            <TextBox x:Name="StockDesc"
                                     FontSize="24"
                                     Width="325"
                                     Height="102"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!--Column 4 Buttons-->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,176,-88,0" Height="64" Width="746" Grid.ColumnSpan="2">

                            <Button Content="Save" 
                                    Width="255" Height="62"
                                    FontWeight="Bold" 
                                    FontSize="35" 
                                    Foreground="White"
                                    Background="#FFAE42"
                                    Click="SaveStock_Click">

                                <!--Save Button Template-->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="10"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                            <Button Content="Clear"
                                    Width="227" 
                                    Height="64" 
                                    FontWeight="Bold" 
                                    FontSize="35" 
                                    Foreground="White" 
                                    Background="#023020" 
                                    Click="Cancel_Click" Margin="10,0,0,0">

                                <!--Clear Button Template-->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                            <Button Content="Delete"
                                    Width="241" 
                                    Height="64" 
                                    FontWeight="Bold" 
                                    FontSize="35" 
                                    Foreground="White" 
                                    Background="#B22222" 
                                    Click="Delete_Click" Margin="10,0,0,0">

                                <!--Delete Button Template-->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </StackPanel>

                    </Grid>
                </Viewbox>

            </Border>

        </Grid>

        <!--Grid Row 2: Table and searchbar-->
        <Grid Grid.Row="2"
               Grid.RowSpan="2"
               Margin="15,0,15,15">

            <!--Table and and searchbar-->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="6"
                     VerticalContentAlignment="Center"
                     Margin="0,21,135,10"
                     Foreground="Gray"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchBox_TextChanged"
                     Grid.ColumnSpan="2" />

            <!-- Deleted Stock button -->
            <Button Content="Deleted Stock"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#0B5D3B"
                    Click="Deleted_Click" Margin="135,21,0,13"/>

            <!-- Stock Table -->
            <DataGrid x:Name="StockTable"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      FontSize="13"
                      RowHeight="32"
                      Margin="0,6,0,30"
                      GridLinesVisibility="Horizontal"
                      MouseDoubleClick="StockTable_MouseDoubleClick">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFAE42"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- BODY STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- EXPLICIT COLUMNS -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Stock Code" Binding="{Binding StockCode}" Width="*" />
                    <DataGridTextColumn Header="Name" Binding="{Binding StockName}" Width="*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding StockDescription}" Width="*" />
                    <DataGridTextColumn Header="Brand Manufacturer" Binding="{Binding Brand}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                    <DataGridTextColumn Header="Cost Per Item" Binding="{Binding Cost}" Width="*" />
                    <DataGridTextColumn Header="Sellling Price Per Item" Binding="{Binding SellingPrice}" Width="*" />
                    <DataGridTextColumn Header="Total Purchase Excl VAT" Binding="{Binding TotalPurchasedExclVat}" Width="*" />
                    <DataGridTextColumn Header="Total Sales Excl VAT" Binding="{Binding TotalSalesExclVat}" Width="*" />
                    <DataGridTextColumn Header="Qauntity Purchased" Binding="{Binding QntyPurchased}" Width="*" />
                    <DataGridTextColumn Header="Qauntity Sold" Binding="{Binding QntySold}" Width="*" />
                    <DataGridTextColumn Header="Stock on Hand" Binding="{Binding StockOnHand}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>

        </Grid>
    </Grid>
</Window>
