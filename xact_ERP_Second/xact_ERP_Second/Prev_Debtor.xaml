<Window x:Class="xact_ERP_Second.Prev_Debtor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xact_ERP_Second"
        mc:Ignorable="d"
        Title="Prev_Debtor" 
        WindowState="Maximized"
        Height="526" 
        Width="840">

    <Grid Margin="0,0,0,0">

        <!-- Background image -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/PD_background.png" Stretch="UniformToFill" Opacity="0.9"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!--row 0-->
            <RowDefinition Height="37*" />

            <!-- row 2  -->
            <RowDefinition Height="133*" />
        </Grid.RowDefinitions>



        <!-- Search and table section -->
        <Grid Grid.Row="1"
              Margin="15,77,15,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="6"
                     VerticalContentAlignment="Center"
                     Margin="0,-67,137,98"
                     Text="Search by Debtor name..."  
                     Foreground="Gray"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchBox_TextChanged" Grid.ColumnSpan="2"/>


            <Button Content="Current Debtors"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#0B5D3B"
                    Click="Current_Click" Margin="135,-65,0,100"/>

            <!-- Table -->
            <DataGrid x:Name="DebtorsTable"
                      Grid.ColumnSpan="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      FontSize="14"
                      RowHeight="32"
                      Margin="0,0,0,30"
                      GridLinesVisibility="Horizontal"
                      Grid.RowSpan="2"
                      SelectionChanged="DebtorsTable_SelectionChanged">


                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFAE42"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- BODY STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- EXPLICIT COLUMNS -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account Code" Binding="{Binding AccountCode}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Delivery Address" Binding="{Binding DeliveryAddress}" Width="*" />
                    <DataGridTextColumn Header="Invoice Address" Binding="{Binding InvoiceAddress}" Width="*" />
                    <DataGridTextColumn Header="Postal Address" Binding="{Binding PostalAddress}" Width="*" />
                    <DataGridTextColumn Header="Account Holder" Binding="{Binding AccountHolder}" Width="*" />
                    <DataGridTextColumn Header="Account Number" Binding="{Binding AcoountNumber}" Width="*" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="*" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sales YTD" Binding="{Binding SalesYearToDate}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cost YTD" Binding="{Binding CostYearToDate}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</Window>
