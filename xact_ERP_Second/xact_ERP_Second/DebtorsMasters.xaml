<Window x:Class="xact_ERP_Second.DebtorsMasters" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xact_ERP_Second" mc:Ignorable="d" 
        Title="DebtorsMasters" 
        WindowState="Maximized"
        Height="526" 
        Width="840">

    <Grid Margin="0,0,0,0">

        <!-- Background image -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/DM_Background.png" Stretch="UniformToFill" Opacity="0.9"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!--row 0-->
            <RowDefinition Height="89*" />
            <!-- row 1 -->
            <RowDefinition Height="127*" />
            <!-- row 2  -->
            <RowDefinition Height="293*" />
        </Grid.RowDefinitions>

        <!-- Green panel -->
        <Grid Margin="15,10,15,0" Grid.Row="1">
            <Border
                    Background="#0B5D3B"
                    CornerRadius="9"
                    Padding="20"
                    Margin="15,10,15,15">

                <Viewbox Stretch="Uniform" 
                         Margin="-16,-10,0,-10" 
                         HorizontalAlignment="Left">

                    <Grid Width="2598" Height="250">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="258"/>
                            <ColumnDefinition Width="842"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0 -->
                        <StackPanel Grid.Column="0" Margin="10,10,10,10">
                            <TextBlock Text="DEBTORS"
                                       Foreground="White"
                                       FontWeight="ExtraBold"
                                       FontSize="70"
                                       Margin="0,0,0,12" Width="369"
                                       HorizontalAlignment="Left" Height="82"/>

                            <TextBlock Text="Name"
                                        Foreground="White"
                                        FontSize="25"/>

                            <TextBox x:Name="Name" 
                                     Height="33" Width="320"
                                     HorizontalAlignment="Left"
                                     FontSize="24"/>

                            <TextBlock Text="Double Click a Debtor in Table to Edit"
                                       Foreground="White"
                                       FontSize="25"
                                       TextAlignment="Left"
                                       Width="489"
                                      Margin="0,30,0,0"/>
                        </StackPanel>

                        <!-- Column 1 -->
                        <StackPanel Grid.Column="1" Margin="10,10,10,10">
                            <TextBlock Text="Delivery Address" 
                                       Foreground="White" 
                                       FontSize="25"/>

                            <TextBox x:Name="DeliveryAddress" 
                                   Height="33" Width="320"
                                     HorizontalAlignment="Left"
                                     FontSize="24"/>

                            <TextBlock Text="Postal Address" 
                                       Foreground="White" 
                                       FontSize="25" 
                                       Margin="0,6,0,0"/>

                            <TextBox x:Name="PostalAddress"
                                Height="33" 
                                Width="320"
                                HorizontalAlignment="Left"
                                FontSize="24"/>

                            <TextBlock Text="Invoice Address"
                                       Foreground="White" 
                                       FontSize="25" 
                                       Margin="0,6,0,0"/>

                            <TextBox  x:Name="InvoiceAddress"
                                      Height="33" 
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      FontSize="24"/>
                        </StackPanel>

                        <!-- Column 2 -->
                        <StackPanel Grid.Column="2" Margin="10,10,10,10">
                            <TextBlock Text="Account Holder"
                                       Foreground="White" 
                                       FontSize="25"/>

                            <TextBox x:Name="AccHolder"
                                      Height="33" 
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      FontSize="24"/>

                            <TextBlock Text="Account Number" 
                                       Foreground="White"
                                       FontSize="25" 
                                       Margin="0,6,0,0"/>

                            <TextBox x:Name="AccNumber"
                                      Height="33" 
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      FontSize="24"/>

                            <TextBlock Text="Branch" 
                                       Foreground="White" 
                                       FontSize="25" 
                                       Margin="0,6,0,0"/>

                            <TextBox x:Name="BranchName"
                                      Height="30" 
                                      Width="320"
                                      HorizontalAlignment="Left"
                                     FontSize="24"/>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,10">

                            <Button Content="Save" Width="233" Height="62" FontWeight="Bold" FontSize="35" Foreground="White" Background="#FFAE42" Click="SaveTransaction_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="Clear" Width="227" Height="64" FontWeight="Bold" FontSize="35" Foreground="White" Background="#023020" Click="Cancel_Click" Margin="10,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Deactivate button: disabled by default -->
                            <Button x:Name="DeactivateButton" Content="Deactivate" Width="250" Height="64" FontWeight="Bold" FontSize="35" Foreground="White" Background="#B22222" Click="Deactivate_Click" Margin="10,0,0,0" IsEnabled="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>


                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Search and table section -->
        <Grid Grid.Row="2"
              Grid.RowSpan="2"
              Margin="15,0,15,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="6"
                     VerticalContentAlignment="Center"
                     Margin="0,21,137,10"
                     Text="Search by Debtor name..."  
                     Foreground="Gray"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchBox_TextChanged" Grid.ColumnSpan="2"/>

            <!-- Previous Debtors button -->
            <Button Content="Prev Debtors"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#0B5D3B"
                    Click="Prev_Click" Margin="135,21,0,0" Height="31" VerticalAlignment="Top"/>

            <!-- Table -->
            <DataGrid x:Name="DebtorsTable"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      FontSize="14"
                      RowHeight="32"
                      Margin="0,6,0,30"
                      GridLinesVisibility="Horizontal"
                      MouseDoubleClick="DebtorsTable_MouseDoubleClick">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFAE42"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- BODY STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- EXPLICIT COLUMNS -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account Code" Binding="{Binding AccountCode}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Delivery Address" Binding="{Binding DeliveryAddress}" Width="*" />
                    <DataGridTextColumn Header="Invoice Address" Binding="{Binding InvoiceAddress}" Width="*" />
                    <DataGridTextColumn Header="Postal Address" Binding="{Binding PostalAddress}" Width="*" />
                    <DataGridTextColumn Header="Account Holder" Binding="{Binding AccountHolder}" Width="*" />
                    <DataGridTextColumn Header="Account Number" Binding="{Binding AcoountNumber}" Width="*" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="*" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Sales YTD" Binding="{Binding SalesYearToDate}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cost YTD" Binding="{Binding CostYearToDate}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</Window>
