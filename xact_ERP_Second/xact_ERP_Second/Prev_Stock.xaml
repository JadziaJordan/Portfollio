<Window x:Class="xact_ERP_Second.Prev_Stock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xact_ERP_Second"
        mc:Ignorable="d"
        Title="Prev_Stock"         WindowState="Maximized"
        Height="526" 
        Width="840">

    <Grid Margin="0,0,0,0">

        <!-- Background image -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/PS_background.png" Stretch="UniformToFill" Opacity="0.9"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <!--row 0-->
            <RowDefinition Height="37*" />

            <!-- row 2  -->
            <RowDefinition Height="133*" />
        </Grid.RowDefinitions>



        <!-- Search and table section -->
        <Grid Grid.Row="1"
              Margin="15,77,15,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="6"
                     VerticalContentAlignment="Center"
                     Margin="0,-67,137,98"
                     Foreground="Gray"
                    
                     TextChanged="SearchBox_TextChanged" Grid.ColumnSpan="2"/>

            <!--GotFocus="SearchBox_GotFocus"
 LostFocus="SearchBox_LostFocus"-->


            <Button Content="Current Stock"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#0B5D3B"
                    Click="Current_Click" Margin="135,-65,0,100"/>

            <!-- Table -->
            <DataGrid x:Name="StockTable"
                      Grid.ColumnSpan="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      FontSize="14"
                      RowHeight="32"
                      Margin="0,0,0,30"
                      GridLinesVisibility="Horizontal"
                      Grid.RowSpan="2" SelectionChanged="StockTable_SelectionChanged">



                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFAE42"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- BODY STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- EXPLICIT COLUMNS -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Stock Code" Binding="{Binding StockCode}" Width="*" />
                    <DataGridTextColumn Header="Name" Binding="{Binding StockName}" Width="*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding StockDescription}" Width="*" />
                    <DataGridTextColumn Header="Brand Manufacturer" Binding="{Binding Brand}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                    <DataGridTextColumn Header="Cost Per Item" Binding="{Binding Cost}" Width="*" />
                    <DataGridTextColumn Header="Sellling Price Per Item" Binding="{Binding SellingPrice}" Width="*" />
                    <DataGridTextColumn Header="Total Purchase Excl VAT" Binding="{Binding TotalPurchasedExclVat}" Width="*" />
                    <DataGridTextColumn Header="Total Sales Excl VAT" Binding="{Binding TotalSalesExclVat}" Width="*" />
                    <DataGridTextColumn Header="Qauntity Purchased" Binding="{Binding QntyPurchased}" Width="*" />
                    <DataGridTextColumn Header="Qauntity Sold" Binding="{Binding QntySold}" Width="*" />
                    <DataGridTextColumn Header="Stock on Hand" Binding="{Binding StockOnHand}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

    </Grid>
</Window>
