<Window x:Class="xact_ERP_Second.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800" WindowState="Maximized">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left image -->
        <Border Grid.Column="0">
            <Image Source="pack://application:,,,/Images/MenuPage.png"
                   Stretch="UniformToFill"
                   Opacity="100"/>
        </Border>

        <!-- Right menu -->
        <Border Grid.Column="1" Background="LightGray" Padding="10">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Margin="20,40,0,40">

                    <!-- 01 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="01" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Maintain Debtors"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step1_Click"/>
                    </StackPanel>

                    <!-- 02 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="02" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Maintain Stock"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step2_Click"/>
                    </StackPanel>

                    <!-- 03 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="03" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Debtors Enquiry"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step3_Click"/>
                    </StackPanel>

                    <!-- 04 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="04" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Stock Enquiry"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step4_Click"/>
                    </StackPanel>

                    <!-- 05 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="05" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Stock Adjustments"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step5_Click"/>
                    </StackPanel>

                    <!-- 06 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="06" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Invoicing Enquiry"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step6_Click"/>
                    </StackPanel>

                    <!-- 07 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="#0B5D3B"/>
                            <TextBlock Text="07" Foreground="White" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <Button Content="Create a New Invoice"
                                FontWeight="Bold"
                                FontSize="14"
                                Foreground="Black"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                Click="Step7_Click"/>
                    </StackPanel>

                </StackPanel>
            </Viewbox>
        </Border>

    </Grid>
</Window>
